{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "se.johan.glue",
  "version": "1.0.3",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Glue Lock",
    "sv": "Glue Lock"
  },
  "description": {
    "en": "Lock and unlock your doors from anywhere",
    "sv": "Lås och lås upp dina dörrar var du än är"
  },
  "category": [
    "security"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "author": {
    "name": "Johan Sjöström"
  },
  "brandColor": "#2F6FED",
  "api": {
    "getTest": {
      "method": "GET",
      "path": "/test"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "postLogin": {
      "method": "POST",
      "path": "/login"
    },
    "postLogout": {
      "method": "POST",
      "path": "/logout"
    }
  },
  "support": "https://github.com/Bendify/homey-glue-lock/issues",
  "source": "https://github.com/Bendify/homey-glue-lock",
  "bugs": {
    "url": "https://github.com/Bendify/homey-glue-lock/issues"
  },
  "homepage": "https://github.com/Bendify/homey-glue-lock",
  "flow": {
    "triggers": [
      {
        "id": "lock_disconnected",
        "title": {
          "en": "A lock lost its connection",
          "sv": "Ett lås tappade anslutningen"
        },
        "hint": {
          "en": "Fires once when a lock has been disconnected or offline for about two minutes, usually because the Glue hub lost its wifi. Does not fire again until the lock has been connected in between.",
          "sv": "Utlöses en gång när ett lås varit frånkopplat eller offline i ungefär två minuter, oftast för att Glue-hubben tappat wifi. Utlöses inte igen förrän låset varit anslutet emellan."
        },
        "tokens": [
          {
            "name": "door",
            "type": "string",
            "title": {
              "en": "Door",
              "sv": "Dörr"
            },
            "example": {
              "en": "Front door",
              "sv": "Ytterdörr"
            }
          },
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "Status",
              "sv": "Status"
            },
            "example": {
              "en": "disconnected",
              "sv": "disconnected"
            }
          }
        ]
      },
      {
        "id": "lock_failed",
        "title": {
          "en": "A lock could not be locked",
          "sv": "Ett lås kunde inte låsas"
        },
        "hint": {
          "en": "Fires after 'Lock all doors' for each lock that is offline, returned an error, or was not locked after about 20 seconds.",
          "sv": "Utlöses efter 'Lås alla dörrar' för varje lås som är offline, gav fel eller inte var låst efter cirka 20 sekunder."
        },
        "tokens": [
          {
            "name": "door",
            "type": "string",
            "title": {
              "en": "Door",
              "sv": "Dörr"
            },
            "example": {
              "en": "Garage front",
              "sv": "Garage fram"
            }
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "sv": "Orsak"
            },
            "example": {
              "en": "offline",
              "sv": "offline"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "lock_all",
        "title": {
          "en": "Lock all doors",
          "sv": "Lås alla dörrar"
        },
        "hint": {
          "en": "Locks all Glue locks. After about 20 seconds the app checks the result and fires the trigger 'A lock could not be locked' for every lock that is offline or did not lock. There is intentionally no 'unlock all'.",
          "sv": "Låser alla Glue-lås. Efter cirka 20 sekunder kontrollerar appen resultatet och utlöser triggern 'Ett lås kunde inte låsas' för varje lås som är offline eller inte låste. Det finns medvetet ingen 'lås upp alla'."
        }
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Glue Lock",
        "sv": "Glue Lock"
      },
      "class": "lock",
      "capabilities": [
        "locked",
        "measure_battery",
        "last_event",
        "command_status"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/lock/assets/images/small.jpg",
        "large": "/drivers/lock/assets/images/large.jpg",
        "xlarge": "/drivers/lock/assets/images/xlarge.jpg"
      },
      "pair": [
        {
          "id": "login",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "energy": {
        "batteries": [
          "AA",
          "AA",
          "AA",
          "AA"
        ]
      },
      "id": "lock"
    }
  ],
  "capabilities": {
    "command_status": {
      "type": "string",
      "title": {
        "en": "Command status",
        "sv": "Kommandostatus"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": false,
      "icon": "/assets/command_status.svg"
    },
    "last_event": {
      "type": "string",
      "title": {
        "en": "Last event",
        "sv": "Senaste händelse"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": false,
      "icon": "/assets/last_event.svg"
    }
  }
}