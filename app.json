      "method": "POST",
      "path": "/login"
    },
    "postLogout": {
      "method": "POST",
      "path": "/logout"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "lock_failed",
        "title": {
          "en": "A lock could not be locked",
          "sv": "Ett lås kunde inte låsas"
        },
        "hint": {
          "en": "Fires after 'Lock all doors' for each lock that is offline, returned an error, or was not locked after about 20 seconds.",
          "sv": "Utlöses efter 'Lås alla dörrar' för varje lås som är offline, gav fel eller inte var låst efter cirka 20 sekunder."
        },
        "tokens": [
          {
            "name": "door",
            "type": "string",
            "title": {
              "en": "Door",
              "sv": "Dörr"
            },
            "example": {
              "en": "Garage front",
              "sv": "Garage fram"
            }
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "sv": "Orsak"
            },
            "example": {
              "en": "offline",
              "sv": "offline"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "lock_all",
        "title": {
          "en": "Lock all doors",
          "sv": "Lås alla dörrar"
        },
        "hint": {
          "en": "Locks all Glue locks. After about 20 seconds the app checks the result and fires the trigger 'A lock could not be locked' for every lock that is offline or did not lock. There is intentionally no 'unlock all'.",
          "sv": "Låser alla Glue-lås. Efter cirka 20 sekunder kontrollerar appen resultatet och utlöser triggern 'Ett lås kunde inte låsas' för varje lås som är offline eller inte låste. Det finns medvetet ingen 'lås upp alla'."
        }
      }
    ]
  },
